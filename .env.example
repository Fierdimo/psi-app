# Copiar a `.env.local` y rellenar. `.env.local` NUNCA se sube al repositorio.

# --- Marca -------------------------------------------------------------------
# Punto único para cambiar el nombre visible cuando llegue la identidad real.
NEXT_PUBLIC_BRAND_NAME=JBR Psicometrías

# --- Supabase ----------------------------------------------------------------
# Estos tres valores son TODO lo que cambia entre desplegar contra Supabase
# gestionado o contra el mismo stack en un VPS. Ese es el contrato de
# portabilidad de PLAN.md §3.2.
#
# En local, `supabase start` los imprime al terminar de arrancar.
NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:54321"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Clave de servicio: SOLO servidor. Jamás con prefijo NEXT_PUBLIC_, jamás
# importada desde un componente cliente. Salta RLS por completo.
SUPABASE_SERVICE_ROLE_KEY=""

# --- Tareas programadas ---------------------------------------------------
# Secreto que protege /api/tareas/recordatorios. Sin él, el endpoint queda
# deshabilitado (503), no abierto.
TAREAS_SECRETO=""

# --- Correo ------------------------------------------------------------------
# UNA sola configuración para todo. Por aquí salen tanto los transaccionales
# que envía la aplicación —cita confirmada, invitación, recordatorio— como los
# de autenticación que envía Supabase, que usa estas mismas credenciales en su
# propia configuración.
#
# TAL COMO ESTÁ, apunta al Mailpit que levanta `supabase start`: los correos se
# ven en http://127.0.0.1:54324 y no sale nada a internet.
SMTP_HOST="127.0.0.1"
SMTP_PORT="54325"
SMTP_USER=""
SMTP_PASS=""
CORREO_REMITENTE="JBR Psicometrías <no-responder@ejemplo.com>"

# EN PRODUCCIÓN se envía por Google. Sustituye los cuatro valores de arriba por
# estos y rellena la clave:
#
#   SMTP_HOST="smtp.gmail.com"
#   SMTP_PORT="587"
#   SMTP_USER="no-responder@jbrpsicometrias.com"
#   SMTP_PASS="xxxx xxxx xxxx xxxx"
#   CORREO_REMITENTE="JBR Psicometrías <no-responder@jbrpsicometrias.com>"
#
# Tres avisos, cada uno vale una tarde:
#
#  1. SMTP_PASS NO es la contraseña de la cuenta: es una CONTRASEÑA DE
#     APLICACIÓN de 16 caracteres, y crearla exige tener activada la
#     verificación en dos pasos.
#  2. CORREO_REMITENTE tiene que llevar la MISMA dirección que SMTP_USER. Si
#     no, Google la reescribe sin avisar y quien recibe ve la cuenta real. No
#     da error: el correo llega, con otro remitente.
#  3. Gmail gratuito corta sobre los 500 destinatarios al día; Workspace, sobre
#     los 2.000. Una tanda de invitaciones son decenas, pero conviene saber
#     dónde está el techo.
