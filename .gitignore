# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# …salvo la plantilla, que existe justo para compartirse: el patrón de arriba
# la barría con los secretos y nadie fuera de esta máquina la había visto nunca.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# Archivos de asistentes de IA — no forman parte del proyecto
CLAUDE.md
AGENTS.md
.claude/

# Herramientas de agente, no del proyecto.
#
# Entraron al repositorio por un `git add -A` mío y se quedaron: 321 archivos
# que no describen esta aplicación ni la hacen funcionar. Se quedan en disco,
# fuera del historial.
.agents/
.codex/
.github/skills/
.github/agents/
.github/hooks/
skills-lock.json
.impeccable/

# Estado efímero de `supabase start`.
supabase/.temp

# Credenciales del servidor. Nunca al repositorio: el archivo trae la
# contraseña de root en claro, y un repositorio recuerda para siempre.
VPS-access.txt
*-access.txt
